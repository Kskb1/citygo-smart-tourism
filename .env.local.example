# Copy this file to .env.local, then replace the placeholder values with your real keys.
# .env.local is ignored by Git and should stay only on your machine.

AMAP_API_KEY=你的高德开放平台Web服务Key
AMADEUS_CLIENT_ID=你的Amadeus ClientId
AMADEUS_CLIENT_SECRET=你的Amadeus ClientSecret
AMADEUS_ENV=test
TRAIN_PROVIDER=official_redirect
TRAIN_API_KEY=

MYSQL_URL=jdbc:mysql://localhost:3306/citygo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USER=root
MYSQL_PASSWORD=你的本地MySQL密码

JWT_SECRET=本地开发用长随机字符串
JWT_TTL_HOURS=24
CITYGO_TRIP_MAX_PLAN_JSON_BYTES=5242880
CITYGO_ADMIN_USERNAME=admin
CITYGO_ADMIN_PASSWORD=
CITYGO_ADMIN_EMAIL=admin@citygo.local
CITYGO_DEMO_USERS_ENABLED=true

# Optional: frontend map display key. Leave blank to use the built-in route diagram fallback.
VITE_AMAP_JS_API_KEY=
